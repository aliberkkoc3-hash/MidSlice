		addPanelPart(new FlxSprite(px + 34, divY).makeGraphic(pw - 68, 1, 0xFF2A2244));
		addPanelPart(new FlxSprite(px + 34, divY + 2).makeGraphic(pw - 68, 1, 0xFF0A0812));
		addPanelPart(new FlxSprite(px + Std.int(pw / 2) - 6, divY - 4).makeGraphic(12, 10, 0xFF100D1A));
		addPanelPart(new FlxSprite(px + Std.int(pw / 2) - 4, divY - 3).makeGraphic(8, 8, 0xFF398CFF));
		addPanelPart(new FlxSprite(px + Std.int(pw / 2) - 2, divY - 1).makeGraphic(4, 4, 0xFF100D1A));

		// ══════════════════════════════════
		// ── SECTION 02: HIT EFFECTS ──
		// ══════════════════════════════════
		var sec2Y = py + 304;

		addPanelPart(new FlxSprite(px + 34, sec2Y)
			.makeGraphic(38, 38, 0xFF398CFF));
		addPanelPart(new FlxSprite(px + 36, sec2Y + 2)
			.makeGraphic(34, 34, 0xFF100D1A));
		addPanelText(px + 34, sec2Y + 9, 38,
			"02", 12, 0xFF9BCBFF);

		addPanelText(px + 82, sec2Y + 2, 400,
