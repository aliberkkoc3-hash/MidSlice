		// ══════════════════════════════════════════════════════════
		// ── LAUNCHER CARD ──
		// ══════════════════════════════════════════════════════════
		var lw = 380;
		var lh = 120;
		var lx = FlxG.width - lw - 36;
		var ly = (FlxG.height - lh) / 2;

		launcherGlow = new FlxSprite(lx - 6, ly - 6)
			.makeGraphic(lw + 12, lh + 12, 0xFF1A1030);
		launcherGlow.scrollFactor.set(0, 0);
		menuUi.add(launcherGlow);

		var launcherGlow2 = new FlxSprite(lx - 3, ly - 3)
			.makeGraphic(lw + 6, lh + 6, 0xFF3D2E66);
		launcherGlow2.scrollFactor.set(0, 0);
		menuUi.add(launcherGlow2);

		launcherShadow = new FlxSprite(lx + 10, ly + 10)
			.makeGraphic(lw, lh, 0xFF02010A);
		launcherShadow.scrollFactor.set(0, 0);
		menuUi.add(launcherShadow);

		launcherButton = new FlxSprite(lx, ly)
			.makeGraphic(lw, lh, 0xFF100D1A);
		launcherButton.scrollFactor.set(0, 0);
		menuUi.add(launcherButton);

		var launcherTone = new FlxSprite(lx + 1, ly + 1)
			.makeGraphic(lw - 2, 60, 0xFF160F24);
		launcherTone.alpha = 0.6;
		launcherTone.scrollFactor.set(0, 0);
		menuUi.add(launcherTone);

		var launcherBorder = new FlxSprite(lx + 3, ly + 3)
			.makeGraphic(lw - 6, 1, 0xFF2A2244);
		launcherBorder.scrollFactor.set(0, 0);
		menuUi.add(launcherBorder);

		var launcherBorderB = new FlxSprite(lx + 3, ly + lh - 4)
			.makeGraphic(lw - 6, 1, 0xFF2A2244);
		launcherBorderB.scrollFactor.set(0, 0);
		menuUi.add(launcherBorderB);

		var cTL = new FlxSprite(lx, ly).makeGraphic(28, 4, 0xFFFF405D);
		cTL.scrollFactor.set(0, 0); menuUi.add(cTL);
		var cTLv = new FlxSprite(lx, ly).makeGraphic(4, 28, 0xFFFF405D);
		cTLv.scrollFactor.set(0, 0); menuUi.add(cTLv);

		var cTR = new FlxSprite(lx + lw - 28, ly).makeGraphic(28, 4, 0xFF398CFF);
		cTR.scrollFactor.set(0, 0); menuUi.add(cTR);
		var cTRv = new FlxSprite(lx + lw - 4, ly).makeGraphic(4, 28, 0xFF398CFF);
		cTRv.scrollFactor.set(0, 0); menuUi.add(cTRv);

		var cBL = new FlxSprite(lx, ly + lh - 4).makeGraphic(28, 4, 0xFF398CFF);
		cBL.scrollFactor.set(0, 0); menuUi.add(cBL);
		var cBLv = new FlxSprite(lx, ly + lh - 28).makeGraphic(4, 28, 0xFF398CFF);
		cBLv.scrollFactor.set(0, 0); menuUi.add(cBLv);

		var cBR = new FlxSprite(lx + lw - 28, ly + lh - 4).makeGraphic(28, 4, 0xFFFF405D);
		cBR.scrollFactor.set(0, 0); menuUi.add(cBR);
		var cBRv = new FlxSprite(lx + lw - 4, ly + lh - 28).makeGraphic(4, 28, 0xFFFF405D);
		cBRv.scrollFactor.set(0, 0); menuUi.add(cBRv);

		launcherAccent = new FlxSprite(lx, ly)
			.makeGraphic(8, lh, 0xFFFF405D);
		launcherAccent.scrollFactor.set(0, 0);
		menuUi.add(launcherAccent);

		launcherAccent2 = new FlxSprite(lx + 8, ly)
			.makeGraphic(2, lh, 0xFFFF8198);
		launcherAccent2.scrollFactor.set(0, 0);
		menuUi.add(launcherAccent2);

		launcherDot = new FlxSprite(lx + lw - 36, ly + 24)
			.makeGraphic(14, 14, 0xFFFF405D);
		launcherDot.scrollFactor.set(0, 0);
		menuUi.add(launcherDot);

		var launcherDotInner = new FlxSprite(lx + lw - 32, ly + 28)
			.makeGraphic(6, 6, 0xFFFF8198);
		launcherDotInner.scrollFactor.set(0, 0);
		menuUi.add(launcherDotInner);

		launcherLabel = new FlxText(
			lx + 26, ly + 26,
			lw - 70, "MIDSLICE", 18
