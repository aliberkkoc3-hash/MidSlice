		// ══════════════════════════════════
		// ── CORNER BRACKETS ──
		// ══════════════════════════════════
		addPanelPart(new FlxSprite(px, py).makeGraphic(42, 5, 0xFFFF405D));
		addPanelPart(new FlxSprite(px, py).makeGraphic(5, 42, 0xFFFF405D));
		addPanelPart(new FlxSprite(px, py + 42).makeGraphic(12, 2, 0xFFFF8198));
		addPanelPart(new FlxSprite(px + 42, py).makeGraphic(12, 2, 0xFFFF8198));

		addPanelPart(new FlxSprite(px + pw - 42, py).makeGraphic(42, 5, 0xFF398CFF));
		addPanelPart(new FlxSprite(px + pw - 5, py).makeGraphic(5, 42, 0xFF398CFF));
		addPanelPart(new FlxSprite(px + pw - 12, py + 42).makeGraphic(12, 2, 0xFF9BCBFF));
		addPanelPart(new FlxSprite(px + pw - 54, py).makeGraphic(12, 2, 0xFF9BCBFF));

		addPanelPart(new FlxSprite(px, py + ph - 5).makeGraphic(42, 5, 0xFF398CFF));
		addPanelPart(new FlxSprite(px, py + ph - 42).makeGraphic(5, 42, 0xFF398CFF));
		addPanelPart(new FlxSprite(px, py + ph - 44).makeGraphic(12, 2, 0xFF9BCBFF));
		addPanelPart(new FlxSprite(px + 42, py + ph - 2).makeGraphic(12, 2, 0xFF9BCBFF));

		addPanelPart(new FlxSprite(px + pw - 42, py + ph - 5).makeGraphic(42, 5, 0xFFFF405D));
		addPanelPart(new FlxSprite(px + pw - 5, py + ph - 42).makeGraphic(5, 42, 0xFFFF405D));
		addPanelPart(new FlxSprite(px + pw - 12, py + ph - 44).makeGraphic(12, 2, 0xFFFF8198));
		addPanelPart(new FlxSprite(px + pw - 54, py + ph - 2).makeGraphic(12, 2, 0xFFFF8198));

		// ══════════════════════════════════
		// ── TOP COLOR BAND ──
		// ══════════════════════════════════
		var mid = Std.int(pw / 2);
		addPanelPart(new FlxSprite(px + 5, py + 5)
			.makeGraphic(mid - 5, 7, 0xFFFF405D));
		addPanelPart(new FlxSprite(px + mid, py + 5)
			.makeGraphic(mid - 5, 7, 0xFF398CFF));
		addPanelPart(new FlxSprite(px + 5, py + 5)
			.makeGraphic(mid - 5, 1, 0xFFFFB0C0));
		addPanelPart(new FlxSprite(px + mid, py + 5)
