		launcherLabel.setFormat(Paths.font("vcr.ttf"), 18, 0xFFFFFFFF);
		launcherLabel.scrollFactor.set(0, 0);
		menuUi.add(launcherLabel);

		launcherSubLabel = new FlxText(
			lx + 26, ly + 54,
			lw - 70, "SETTINGS HUB", 10
		);
		launcherSubLabel.setFormat(Paths.font("vcr.ttf"), 10, 0xFFFF8198);
		launcherSubLabel.scrollFactor.set(0, 0);
		menuUi.add(launcherSubLabel);

		launcherArrow = new FlxText(
			lx + lw - 40, ly + lh - 36,
			28, ">", 14
		);
		launcherArrow.setFormat(Paths.font("vcr.ttf"), 14, 0xFF398CFF);
		launcherArrow.scrollFactor.set(0, 0);
		menuUi.add(launcherArrow);

		var ld1 = new FlxSprite(lx + 26, ly + 88).makeGraphic(5, 5, 0xFFFF405D);
		ld1.scrollFactor.set(0, 0); menuUi.add(ld1);
		var ld2 = new FlxSprite(lx + 38, ly + 88).makeGraphic(5, 5, 0xFF398CFF);
		ld2.scrollFactor.set(0, 0); menuUi.add(ld2);
		var ld3 = new FlxSprite(lx + 50, ly + 88).makeGraphic(5, 5, 0xFF5A4E70);
		ld3.scrollFactor.set(0, 0); menuUi.add(ld3);

		var launcherHalf = Std.int(lw / 2);
		var lab = new FlxSprite(lx, ly + lh - 3)
			.makeGraphic(launcherHalf, 3, 0xFFFF405D);
		lab.scrollFactor.set(0, 0);
		menuUi.add(lab);

		var lab2 = new FlxSprite(lx + launcherHalf, ly + lh - 3)
			.makeGraphic(lw - launcherHalf, 3, 0xFF398CFF);
		lab2.scrollFactor.set(0, 0);
		menuUi.add(lab2);

		menuState.add(menuUi);

		refreshPanelVisibility();
	}

	function addPanelPart(sprite:FlxSprite):Void {
		settingsPanel.add(sprite);
	}

	function addPanelText(
		x:Float,
		y:Float,
		width:Float,
		text:String,
		size:Int,
		color:Int
	):Void {
		var label = new FlxText(x, y, width, text, size);
		label.setFormat(Paths.font("vcr.ttf"), size, color);
		settingsPanel.add(label);
	}

	function updateMenuPanel():Void {
		var hoveringLauncher = mouseOver(launcherButton);

		launcherButton.color = hoveringLauncher
			? 0xFF1E1830
			: 0xFF100D1A;

		launcherAccent.color = hoveringLauncher
			? 0xFF398CFF
			: 0xFFFF405D;

		launcherAccent2.color = hoveringLauncher
			? 0xFF9BCBFF
			: 0xFFFF8198;

		launcherSubLabel.color = hoveringLauncher
			? 0xFF9BCBFF
			: 0xFFFF8198;

		launcherDot.color = hoveringLauncher
			? 0xFF398CFF
			: 0xFFFF405D;

		launcherArrow.color = hoveringLauncher
			? 0xFFFF405D
			: 0xFF398CFF;

		if (FlxG.mouse.justPressed) {
			if (hoveringLauncher) {
				togglePanel();
			} else if (panelOpen && mouseOver(upButton)) {
				setDownscroll(false);
			} else if (panelOpen && mouseOver(downButton)) {
				setDownscroll(true);
			} else if (panelOpen && mouseOver(animationButton)) {
				toggleAnimations();
			} else if (panelOpen && mouseOver(closeButton)) {
				panelOpen = false;
				refreshPanelVisibility();
			}
		}

		var downscroll = isDownscrollSelected();

		upButton.color = downscroll
			? 0xFF1A1420
			: 0xFF4A1E30;
		upGlow.color = downscroll
			? 0xFF2A1A28
			: 0xFFFF405D;
		upIndicator.visible = !downscroll;

		downButton.color = downscroll
			? 0xFF1E3A6A
			: 0xFF141828;
		downGlow.color = downscroll
			? 0xFF398CFF
			: 0xFF1A2238;
		downIndicator.visible = downscroll;

		animationButton.color = animationsEnabled
			? 0xFF32182A
			: 0xFF181622;
		animationGlow.color = animationsEnabled
			? 0xFFFF405D
			: 0xFF2A2238;
		animationIndicator.color = animationsEnabled
			? 0xFFFF405D
			: 0xFF4A4460;
		animationStatusDot.color = animationsEnabled
			? 0xFFFF405D
			: 0xFF4A4460;

		animationLabel.text = animationsEnabled
			? "HIT ANIMATION: ON"
			: "HIT ANIMATION: OFF";

		if (panelOpen && mouseOver(closeButton)) {
			closeButton.color = 0xFF4A1830;
			closeGlow.color = 0xFF5A2038;
		} else {
			closeButton.color = 0xFF2A1828;
			closeGlow.color = 0xFF3A1020;
		}
	}

	function mouseOver(sprite:FlxSprite):Bool {
		if (sprite == null) return false;

		return FlxG.mouse.x >= sprite.x
			&& FlxG.mouse.x <= sprite.x + sprite.width
			&& FlxG.mouse.y >= sprite.y
			&& FlxG.mouse.y <= sprite.y + sprite.height;
	}

	function refreshPanelVisibility():Void {
		if (settingsPanel != null) {
			settingsPanel.visible = panelOpen;
		}
	}
}
