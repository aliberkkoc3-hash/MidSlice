		innerTone.alpha = 0.6;
		addPanelPart(innerTone);

		// ══════════════════════════════════
		// ── DOUBLE INNER BORDER ──
		// ══════════════════════════════════
		addPanelPart(new FlxSprite(px + 3, py + 3)
			.makeGraphic(pw - 6, 1, 0xFF2A2244));
		addPanelPart(new FlxSprite(px + 3, py + ph - 4)
			.makeGraphic(pw - 6, 1, 0xFF2A2244));
		addPanelPart(new FlxSprite(px + 3, py + 3)
			.makeGraphic(1, ph - 6, 0xFF2A2244));
		addPanelPart(new FlxSprite(px + pw - 4, py + 3)
			.makeGraphic(1, ph - 6, 0xFF2A2244));

		addPanelPart(new FlxSprite(px + 8, py + 8)
			.makeGraphic(pw - 16, 1, 0xFF1A1428));
		addPanelPart(new FlxSprite(px + 8, py + ph - 9)
			.makeGraphic(pw - 16, 1, 0xFF1A1428));
		addPanelPart(new FlxSprite(px + 8, py + 8)
			.makeGraphic(1, ph - 16, 0xFF1A1428));
		addPanelPart(new FlxSprite(px + pw - 9, py + 8)
