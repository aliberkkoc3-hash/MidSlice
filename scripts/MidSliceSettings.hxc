		addPanelText(px + 82, sec2Y + 22, 400,
			"Toggle animation flair", 9, 0xFFBEB6CB);

		var animY = sec2Y + 48;

		animationGlow = new FlxSprite(px + 32, animY - 2)
			.makeGraphic(pw - 64, 84, 0xFFFF405D);
		addPanelPart(animationGlow);

		addPanelPart(new FlxSprite(px + 34, animY)
			.makeGraphic(pw - 68, 80, 0xFF0A0612));

		animationButton = new FlxSprite(px + 36, animY + 2)
			.makeGraphic(pw - 72, 76, 0xFF28182A);
		addPanelPart(animationButton);

		animationIndicator = new FlxSprite(px + 36, animY + 2)
			.makeGraphic(6, 76, 0xFFFF405D);
		addPanelPart(animationIndicator);

		animationStatusDot = new FlxSprite(px + pw - 72, animY + 30)
