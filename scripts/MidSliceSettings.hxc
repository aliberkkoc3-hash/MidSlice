		addPanelPart(new FlxSprite(col2X + 2 + Std.int(btnW / 2) - 10, btnY + 70)
			.makeGraphic(4, 10, 0xFF9BCBFF));
		addPanelPart(new FlxSprite(col2X + 2 + Std.int(btnW / 2) - 2, btnY + 70)
