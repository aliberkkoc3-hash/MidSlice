import flixel.FlxG;
import flixel.FlxState;
import flixel.FlxSprite;
import flixel.group.FlxSpriteGroup;
import flixel.text.FlxText;
import funkin.Paths;
import funkin.Preferences;
import funkin.modding.module.Module;
import funkin.modding.events.ScriptEvent.UpdateScriptEvent;
import funkin.ui.mainmenu.MainMenuState;

class MidSliceSettings extends Module {
	var menuUi:FlxSpriteGroup;
	var settingsPanel:FlxSpriteGroup;
	var menuState:FlxState;

	var launcherShadow:FlxSprite;
	var launcherButton:FlxSprite;
	var launcherAccent:FlxSprite;
	var launcherAccent2:FlxSprite;
	var launcherGlow:FlxSprite;
	var launcherLabel:FlxText;
	var launcherSubLabel:FlxText;
	var launcherDot:FlxSprite;
	var launcherArrow:FlxText;

	var upButton:FlxSprite;
	var downButton:FlxSprite;
	var upGlow:FlxSprite;
	var downGlow:FlxSprite;
	var closeButton:FlxSprite;
	var closeGlow:FlxSprite;
	var animationButton:FlxSprite;
	var animationGlow:FlxSprite;
	var animationLabel:FlxText;
	var animationStatusDot:FlxSprite;

	var upIndicator:FlxSprite;
	var downIndicator:FlxSprite;
	var animationIndicator:FlxSprite;

	public var animationsEnabled:Bool = true;
	public var panelOpen:Bool = false;

	public function new() {
		super("MidSliceSettings", 0);
	}

	override function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);

		if (Std.isOfType(FlxG.state, MainMenuState)) {
			if (menuUi == null) {
				createMenuPanel();
			}

			updateMenuPanel();
		} else if (menuUi != null) {
			if (menuState != null) {
				menuState.remove(menuUi, true);
			}

			menuUi.destroy();

			menuUi = null;
			settingsPanel = null;
			menuState = null;
			panelOpen = false;
		}
	}

	function isDownscrollSelected():Bool {
		return Preferences.downscroll;
	}

	public function togglePanel():Void {
		panelOpen = !panelOpen;
		refreshPanelVisibility();
	}

	public function toggleAnimations():Void {
		animationsEnabled = !animationsEnabled;
	}

	public function setDownscroll(value:Bool):Void {
		Preferences.downscroll = value;
	}

	function createMenuPanel():Void {
		menuState = FlxG.state;

		menuUi = new FlxSpriteGroup();
		menuUi.scrollFactor.set(0, 0);

		settingsPanel = new FlxSpriteGroup();
		settingsPanel.scrollFactor.set(0, 0);
		menuUi.add(settingsPanel);

		var pw = 560;
		var ph = 560;
		var px = (FlxG.width - pw) / 2;
		var py = (FlxG.height - ph) / 2;

		// ══════════════════════════════════
		// ── BACKDROP DIMMER ──
		// ══════════════════════════════════
		var dimmer = new FlxSprite()
			.makeGraphic(FlxG.width, FlxG.height, 0xFF03020A);
		dimmer.alpha = 0.75;
		addPanelPart(dimmer);

		// ══════════════════════════════════
		// ── OUTER GLOW LAYERS ──
		// ══════════════════════════════════
		addPanelPart(new FlxSprite(px - 6, py - 6)
			.makeGraphic(pw + 12, ph + 12, 0xFF1A1030));
		addPanelPart(new FlxSprite(px - 3, py - 3)
			.makeGraphic(pw + 6, ph + 6, 0xFF3D2E66));

		addPanelPart(new FlxSprite(px + 14, py + 14)
			.makeGraphic(pw, ph, 0xFF02010A));

		addPanelPart(new FlxSprite(px, py)
			.makeGraphic(pw, ph, 0xFF100D1A));

		var innerTone = new FlxSprite(px + 1, py + 1)
